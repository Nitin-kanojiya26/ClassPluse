@model ClassPluse.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center" style="margin-top: 3rem; margin-bottom: 5rem;">
    <div class="col-md-6 col-lg-5">
        <div class="mb-4">
            <h2 class="fw-bold mb-1">Change Password</h2>
            <p class="text-muted">Update your account password to ensure your data stays secure.</p>
        </div>

        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 text-success border-0 rounded-1 small fw-medium mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
            </div>
        }

        <div class="card border border-light-subtle rounded-1 bg-white shadow-sm p-4 p-md-5">
            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="OldPassword" class="form-label text-muted small fw-medium">Current Password</label>
                    <input asp-for="OldPassword" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" style="border-bottom-color: #dee2e6 !important;" />
                </div>

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label text-muted small fw-medium">New Password</label>
                    <input asp-for="NewPassword" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" style="border-bottom-color: #dee2e6 !important;" />
                </div>

                <div class="mb-5">
                    <label asp-for="ConfirmPassword" class="form-label text-muted small fw-medium">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" style="border-bottom-color: #dee2e6 !important;" />
                </div>

                <div class="d-flex justify-content-end mt-2">
                    <button type="submit" class="btn btn-dark rounded-pill px-5 fw-medium">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-bottom-color: #212529 !important;
        background-color: transparent !important;
    }
</style>
