@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-5">
            <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
            <h2 class="fw-bold mt-3 mb-2">Check Your Email</h2>
            <p class="text-muted fs-5 mb-4">
                If an account with that email address exists, a new password has been sent to it.
            </p>
            <div>
                <a asp-action="Login" class="btn btn-primary px-4 py-2 rounded-2">Return to Login</a>
            </div>
        </div>
    </div>
</div>
