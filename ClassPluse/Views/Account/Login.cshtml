@model ClassPluse.Models.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
            <h1 class="fw-bold mb-2 tracking-tight text-dark">ClassPluse</h1>
            <p class="text-muted">Welcome back. Please log in to your account.</p>
        </div>
        
        <div class="card border border-light-subtle rounded-1 bg-white shadow-sm p-4 p-md-5">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="form-floating mb-4">
                    <input asp-for="Email" class="form-control rounded-1 border-light-subtle bg-light" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Email" class="form-label text-muted">Email address</label>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="form-floating mb-4">
                    <input asp-for="Password" class="form-control rounded-1 border-light-subtle bg-light" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <label asp-for="Password" class="form-label text-muted">Password</label>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div class="form-check">
                        <input class="form-check-input border-secondary" asp-for="RememberMe" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                </div>
                
                <button id="login-submit" type="submit" class="w-100 btn btn-dark btn-lg rounded-pill fw-medium tracking-wider transition-hover">
                    Log In
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-tight { letter-spacing: -1px; }
    .tracking-wider { letter-spacing: 0.05em; }
    .transition-hover { transition: all 0.2s ease-in-out; }
    .transition-hover:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important; }
    
    /* Elegant input focus styling */
    .form-control:focus {
        border-color: #212529;
        box-shadow: 0 0 0 0.15rem rgba(33, 37, 41, 0.1);
        background-color: #ffffff !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
