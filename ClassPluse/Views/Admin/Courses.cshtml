@model IEnumerable<ClassPluse.Models.Course>
@{
    ViewData["Title"] = "Manage Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Manage Courses</h2>
        <p class="text-muted mb-0">View and manage courses and faculty assignments.</p>
    </div>
    <a asp-action="CreateCourse" class="btn btn-info text-white rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Course
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Course Code</th>
                        <th class="py-3">Course Name</th>
                        <th class="py-3">Assigned Faculty</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-medium text-dark">
                                <span class="badge bg-light text-dark border px-2 py-1">@course.CourseCode</span>
                            </td>
                            <td class="py-3 text-dark fw-medium">
                                @course.CourseName
                            </td>
                            <td class="py-3">
                                @if (course.Faculty != null)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @course.Faculty.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span>@course.Faculty.FullName</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <button class="btn btn-sm btn-outline-secondary rounded-circle" title="Edit (Not implemented)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-circle ms-1" title="Delete (Not implemented)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-bookmark fs-1 d-block mb-3 opacity-50"></i>
                                No courses found in the system.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
</style>
