@model ClassPluse.Models.Course

@{
    ViewData["Title"] = "Create Course";
    var facultyList = ViewBag.FacultyList as IEnumerable<ClassPluse.Models.ApplicationUser>;
}

<div class="container mt-4">
    <h2>Create New Course</h2>
    <hr />
    
    <div class="row">
        <div class="col-md-6">
            <form asp-action="CreateCourse">
                <div class="mb-3">
                    <label asp-for="CourseCode" class="form-label">Course Code</label>
                    <input asp-for="CourseCode" class="form-control" required />
                    <span asp-validation-for="CourseCode" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="CourseName" class="form-label">Course Name</label>
                    <input asp-for="CourseName" class="form-control" required />
                    <span asp-validation-for="CourseName" class="text-danger"></span>
                </div>
                
                <div class="mb-3">
                    <label asp-for="FacultyId" class="form-label">Assign Faculty</label>
                    <select asp-for="FacultyId" class="form-select" required>
                        <option value="">-- Select Faculty --</option>
                        @if(facultyList != null)
                        {
                            foreach(var faculty in facultyList)
                            {
                                <option value="@faculty.Id">@faculty.FullName (@faculty.Email)</option>
                            }
                        }
                    </select>
                </div>
                
                <button type="submit" class="btn btn-primary">Save Course</button>
                <a asp-action="Courses" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
