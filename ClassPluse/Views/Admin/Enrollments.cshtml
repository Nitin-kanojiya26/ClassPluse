@model IEnumerable<ClassPluse.Models.Enrollment>
@{
    ViewData["Title"] = "Manage Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Manage Enrollments</h2>
        <p class="text-muted mb-0">View and manage student course enrollments.</p>
    </div>
    <a asp-action="CreateEnrollment" class="btn btn-warning text-dark rounded-pill px-4 shadow-sm fw-medium">
        <i class="bi bi-plus-lg me-1"></i> Enroll Student
    </a>
</div>

<div class="card border border-light-subtle rounded-1 overflow-hidden mb-5">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Student Name</th>
                        <th class="py-3">Id</th>
                        <th class="py-3">Course</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var enrollment in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-medium text-dark">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                        @enrollment.Student?.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span>@enrollment.Student?.FullName</span>
                                </div>
                            </td>
                            <td class="py-3 text-muted">
                                @(enrollment.Student?.RollNumber ?? "-")
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-dark border px-2 py-1 me-2">@enrollment.Course?.CourseCode</span>
                                <span class="text-dark fw-medium">@enrollment.Course?.CourseName</span>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <form asp-action="Unenroll" asp-route-id="@enrollment.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to unenroll this student from this course?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle ms-1" title="Unenroll">
                                        <i class="bi bi-person-dash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-person-lines-fill fs-1 d-block mb-3 opacity-50"></i>
                                No enrollments found in the system.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
</style>
