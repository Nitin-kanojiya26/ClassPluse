@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">System Overview</h2>
        <p class="text-muted mb-0">Manage users, courses, and platform activity.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
    <div class="col">
        <div class="card border border-light-subtle rounded-1 h-100 bg-white transition-hover">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.StudentsCount</h2>
                    <p class="mb-0 text-secondary text-uppercase tracking-wider small fw-bold">Students</p>
                </div>
                <div class="bg-light rounded-circle p-3 text-primary">
                    <i class="bi bi-mortarboard fs-2"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col">
        <div class="card border border-light-subtle rounded-1 h-100 bg-white transition-hover">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.FacultyCount</h2>
                    <p class="mb-0 text-secondary text-uppercase tracking-wider small fw-bold">Faculty</p>
                </div>
                <div class="bg-light rounded-circle p-3 text-info">
                    <i class="bi bi-person-workspace fs-2"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col">
        <div class="card border border-light-subtle rounded-1 h-100 bg-white transition-hover">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.CoursesCount</h2>
                    <p class="mb-0 text-secondary text-uppercase tracking-wider small fw-bold">Courses</p>
                </div>
                <div class="bg-light rounded-circle p-3 text-warning">
                    <i class="bi bi-journal-bookmark fs-2"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col">
        <div class="card border border-light-subtle rounded-1 h-100 bg-white transition-hover">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="display-5 fw-bold mb-0 text-dark">@ViewBag.SessionsToday</h2>
                    <p class="mb-0 text-secondary text-uppercase tracking-wider small fw-bold">Sessions Today</p>
                </div>
                <div class="bg-light rounded-circle p-3 text-success">
                    <i class="bi bi-broadcast fs-2"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-5">
    <div class="col-md-6">
        <h4 class="fw-bold mb-4">Management Areas</h4>
        <div class="row row-cols-1 g-4">
            <div class="col">
                <div class="card border border-light-subtle rounded-1 h-100 transition-hover">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 me-4">
                            <i class="bi bi-people fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">User Management</h5>
                            <p class="text-muted small mb-0">Add, edit, or remove students and faculty.</p>
                        </div>
                        <a asp-action="Users" class="btn btn-outline-primary rounded-pill px-4">Manage</a>
                    </div>
                </div>
            </div>
            
            <div class="col">
                <div class="card border border-light-subtle rounded-1 h-100 transition-hover">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex p-3 me-4">
                            <i class="bi bi-journal-text fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">Course Setup</h5>
                            <p class="text-muted small mb-0">Create new courses and assign faculty.</p>
                        </div>
                        <a asp-action="Courses" class="btn btn-outline-info rounded-pill px-4">Manage</a>
                    </div>
                </div>
            </div>
            
            <div class="col">
                <div class="card border border-light-subtle rounded-1 h-100 transition-hover">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex p-3 me-4">
                            <i class="bi bi-person-lines-fill fs-2"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">Enrollments</h5>
                            <p class="text-muted small mb-0">Enroll students into active courses.</p>
                        </div>
                        <a asp-action="Enrollments" class="btn btn-outline-warning text-dark rounded-pill px-4">Manage</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-6 mt-5 mt-md-0">
        <h4 class="fw-bold mb-4">System Analytics</h4>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border border-light-subtle rounded-1 h-100">
                    <div class="card-body p-4 d-flex flex-column align-items-center">
                        <h6 class="fw-bold mb-3 w-100 text-center">User Distribution</h6>
                        <div style="width: 100%; max-width: 180px; margin: 0 auto;">
                            <canvas id="userDistributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border border-light-subtle rounded-1 h-100">
                    <div class="card-body p-4 d-flex flex-column align-items-center">
                        <h6 class="fw-bold mb-3 w-100 text-center">Course Enrollments</h6>
                        <div style="width: 100%; height: 180px; margin: 0 auto;">
                            <canvas id="courseEnrollmentsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // User Distribution Chart
            const ctxUser = document.getElementById('userDistributionChart').getContext('2d');
            const studentsCount = @ViewBag.StudentsCount;
            const facultyCount = @ViewBag.FacultyCount;
            
            new Chart(ctxUser, {
                type: 'polarArea',
                data: {
                    labels: ['Students', 'Faculty'],
                    datasets: [{
                        data: [studentsCount, facultyCount],
                        backgroundColor: [
                            'rgba(71, 85, 105, 0.7)',   // slate-600
                            'rgba(148, 163, 184, 0.7)', // slate-400
                        ],
                        borderColor: '#ffffff',
                        borderWidth: 1.5,
                        hoverBackgroundColor: 'rgba(51, 65, 85, 0.9)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            ticks: { display: false, backdropColor: 'transparent' },
                            grid: { 
                                color: [
                                    'rgba(0, 0, 0, 0.15)', 
                                    'rgba(0, 0, 0, 0.08)', 
                                    'rgba(0, 0, 0, 0.04)', 
                                    'rgba(0, 0, 0, 0.01)', 
                                    'rgba(0, 0, 0, 0)' 
                                ] 
                            },
                            angleLines: { display: false }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: { family: "'Inter', sans-serif", size: 11 },
                                usePointStyle: true,
                                padding: 15
                            }
                        }
                    }
                }
            });

            // Course Enrollments Bar Chart
            const ctxCourse = document.getElementById('courseEnrollmentsChart').getContext('2d');
            const enrollmentsLabels = @Html.Raw(Json.Serialize(ViewBag.EnrollmentsLabels));
            const enrollmentsData = @Html.Raw(Json.Serialize(ViewBag.EnrollmentsData));

            new Chart(ctxCourse, {
                type: 'bar',
                data: {
                    labels: enrollmentsLabels,
                    datasets: [{
                        label: 'Enrolled Students',
                        data: enrollmentsData,
                        backgroundColor: 'rgba(33, 37, 41, 0.9)', // Dark
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    }
                }
            });
        });
    </script>
}
