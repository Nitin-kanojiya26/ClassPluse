@model IEnumerable<ClassPluse.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0">Manage Users</h2>
        <p class="text-muted mb-0">View and manage system users.</p>
    </div>
    <a asp-action="CreateUser" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add User
    </a>
</div>

<div class="card border border-light-subtle rounded-1 overflow-hidden mb-5">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">User</th>
                        <th class="py-3">Role Info</th>
                        <th class="py-3">Department</th>
                        <th class="pe-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                        @user.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-medium text-dark">@user.FullName</div>
                                        <div class="small text-muted">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                @if(!string.IsNullOrEmpty(user.RollNumber))
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1">Student</span>
                                    <div class="small text-muted mt-1">@user.RollNumber</div>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-2 py-1">Staff / Faculty</span>
                                }
                            </td>
                            <td class="py-3 text-muted">
                                @(user.Department ?? "-")
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary rounded-circle" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this user?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle ms-1" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if(!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-3 opacity-50"></i>
                                No users found in the system.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
</style>
