@{
    ViewData["Title"] = "Faculty Dashboard";
    var courseStats = ViewBag.CourseStats as IEnumerable<dynamic>;
    var recentSessions = ViewBag.RecentSessions as IEnumerable<dynamic>;
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-0">Welcome, Prof. @ViewBag.UserFullName</h2>
        <p class="text-muted mb-0">Overview of your courses and sessions</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <button type="button" class="btn btn-dark btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#startSessionModal">
            <i class="bi bi-play-circle-fill me-2"></i> Start New Session
        </button>
    </div>
</div>

<div class="row mb-5">
    <!-- Courses Column -->
    <div class="col-xl-8">
        <h4 class="fw-bold mb-3 mt-4 mt-xl-0">My Courses</h4>
        <div class="row row-cols-1 row-cols-md-2 g-4">
    @if(courseStats != null && courseStats.Any())
    {
        foreach(var stat in courseStats)
        {
            var course = stat.Course as ClassPluse.Models.Course;
            bool isLive = stat.HasActiveSession;
            double avgAttendance = stat.AvgAttendance;
            string colorClass = avgAttendance >= 75 ? "success" : (avgAttendance >= 65 ? "warning text-dark" : "danger");

            <div class="col">
                <div class="card h-100 border border-light-subtle rounded-1 transition-hover @(isLive ? "border-dark border-2" : "")">
                    <div class="card-header bg-transparent border-0 pt-4 pb-0 d-flex justify-content-between align-items-start">
                        <div>
                            <h6 class="text-muted mb-1"><i class="bi bi-tag me-1"></i> @course?.CourseCode</h6>
                            <h5 class="card-title fw-bold mb-0 text-truncate" title="@course?.CourseName">@course?.CourseName</h5>
                        </div>
                        @if (isLive)
                        {
                            <span class="badge bg-dark rounded-pill px-3 py-2 animate-pulse">
                                <i class="bi bi-record-circle me-1 text-danger"></i> LIVE
                            </span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-2 my-3">
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 h-100">
                                    <div class="fs-4 fw-bold text-dark">@stat.TotalEnrolled</div>
                                    <div class="text-muted small">Enrolled</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 h-100">
                                    <div class="fs-4 fw-bold text-@colorClass">@avgAttendance%</div>
                                    <div class="text-muted small">Avg Att.</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 h-100 d-flex flex-column justify-content-center">
                                    @if(stat.LastSessionDate != null)
                                    {
                                        <div class="fw-bold text-dark fs-6">@(((DateTime)stat.LastSessionDate).ToLocalTime().ToString("MMM dd"))</div>
                                    }
                                    else
                                    {
                                        <div class="fw-bold text-muted fs-6">--</div>
                                    }
                                    <div class="text-muted small">Last Session</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top border-light-subtle py-3 rounded-bottom-1 d-flex gap-2">
                        @if (isLive)
                        {
                            <a asp-action="LiveSession" asp-route-sessionId="@stat.ActiveSessionId" class="btn btn-primary flex-grow-1 rounded-pill fw-medium">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Go to Live
                            </a>
                        }
                        else
                        {
                            <form asp-action="StartSession" method="post" class="flex-grow-1">
                                <input type="hidden" name="courseId" value="@course?.Id" />
                                <button type="submit" class="btn btn-outline-dark w-100 rounded-pill fw-medium">
                                    <i class="bi bi-play-fill me-1"></i> Start
                                </button>
                            </form>
                        }
                        
                        <a asp-action="ClassMatrix" asp-route-courseId="@course?.Id" class="btn btn-outline-secondary rounded-pill" title="Class Matrix">
                            <i class="bi bi-grid-3x3"></i>
                        </a>
                        <a asp-action="Sessions" asp-route-courseId="@course?.Id" class="btn btn-outline-secondary rounded-pill" title="All Sessions">
                            <i class="bi bi-list-ul"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert border border-light-subtle rounded-1 text-center py-4 bg-white text-secondary">
                <i class="bi bi-journal-x fs-4 d-block mb-2"></i>
                You are not assigned to any courses yet.
            </div>
        </div>
    }
        </div>
    </div>
    <!-- Analytics Column -->
    <div class="col-xl-4 mt-5 mt-xl-0">
        <h4 class="fw-bold mb-3">Attendance Analytics</h4>
        <div class="card border border-light-subtle rounded-1 h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-center">
                @if(courseStats != null && courseStats.Any())
                {
                    var totalEnrolled = courseStats.Sum(s => (int)s.TotalEnrolled);
                    var totalCourses = courseStats.Count();
                    var overallAvg = courseStats.Average(s => (double)s.AvgAttendance);

                    <div style="width: 100%; max-width: 320px; margin: 0 auto;">
                        <canvas id="courseAttendanceChart"></canvas>
                    </div>

                    <div class="row g-2 mt-4">
                        <div class="col-6">
                            <div class="bg-light rounded-1 p-3 text-center border border-light-subtle">
                                <h4 class="fw-bold text-dark mb-0">@totalCourses</h4>
                                <span class="text-muted small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Courses</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-light rounded-1 p-3 text-center border border-light-subtle">
                                <h4 class="fw-bold text-dark mb-0">@overallAvg.ToString("0.#")%</h4>
                                <span class="text-muted small text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Overall Avg</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-bar-chart fs-1 d-block mb-3 opacity-50"></i>
                        No data available for analytics.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (recentSessions != null && recentSessions.Any())
{
    <h4 class="fw-bold mb-3">Recent Sessions</h4>
    <div class="card border border-light-subtle rounded-1 overflow-hidden mb-5">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase tracking-wider">
                    <tr>
                        <th class="ps-4 py-3">Date</th>
                        <th class="py-3">Course</th>
                        <th class="py-3">Duration</th>
                        <th class="py-3 text-center">Attendance</th>
                        <th class="pe-4 py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach(var item in recentSessions)
                    {
                        var session = item.Session as ClassPluse.Models.LectureSession;
                        var duration = session!.EndTime.HasValue ? (session.EndTime.Value - session.StartTime).TotalMinutes : 0;
                        int present = item.PresentCount;
                        int total = item.TotalStudents;
                        double percentage = total > 0 ? ((double)present / total) * 100 : 0;
                        string colorClass = percentage >= 75 ? "success" : (percentage >= 65 ? "warning" : "danger");

                        <tr>
                            <td class="ps-4 py-3">
                                <span class="fw-medium text-dark">@session.StartTime.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                <div class="text-muted small">@session.StartTime.ToLocalTime().ToString("hh:mm tt")</div>
                            </td>
                            <td class="py-3">
                                <div class="fw-medium">@session.Course?.CourseName</div>
                            </td>
                            <td class="py-3 text-muted">
                                @Math.Round(duration, 0) mins
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">@present / @total</span>
                                <div class="progress mt-1 mx-auto" style="height: 4px; width: 60px; background-color: #f0f0f0;">
                                    <div class="progress-bar bg-@colorClass" role="progressbar" style="width: @percentage%"></div>
                                </div>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <a asp-action="AdjustAttendance" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil-square me-1"></i> Adjust
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Start Session Modal -->
<div class="modal fade" id="startSessionModal" tabindex="-1" aria-labelledby="startSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-1">
            <form asp-action="StartSession" method="post">
                <div class="modal-header border-bottom-0 pt-4 pb-0 px-4">
                    <h5 class="modal-title fw-bold" id="startSessionModalLabel">Start New Session</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted mb-4">Select a course to start a new live attendance session.</p>
                    <div class="mb-3">
                        <label for="courseSelect" class="form-label fw-medium">Course</label>
                        <select class="form-select form-select-lg rounded-3" id="courseSelect" name="courseId" required>
                            <option value="" selected disabled>Choose a course...</option>
                            @if(courseStats != null)
                            {
                                foreach(var stat in courseStats)
                                {
                                    var course = stat.Course as ClassPluse.Models.Course;
                                    <option value="@course?.Id">@course?.CourseCode - @course?.CourseName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pb-4 px-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark rounded-pill px-4"><i class="bi bi-play-fill me-1"></i> Start Session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-wider { letter-spacing: 0.05em; }
    .transition-hover { transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out; }
    .transition-hover:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
    
    @@keyframes pulse {
        0% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.05); opacity: 0.8; }
        100% { transform: scale(1); opacity: 1; }
    }
    .animate-pulse {
        animation: pulse 2s infinite ease-in-out;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('courseAttendanceChart');
            if (ctx) {
                const labels = [];
                const data = [];
                
                @if(courseStats != null)
                {
                    foreach(var stat in courseStats)
                    {
                        var course = stat.Course as ClassPluse.Models.Course;
                        @:labels.push('@Html.Raw(course?.CourseCode)' + ' - ' + '@Html.Raw(course?.CourseName?.Replace("'", "\\'"))');
                        @:data.push(@stat.AvgAttendance);
                    }
                }

                new Chart(ctx.getContext('2d'), {
                    type: 'polarArea',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Average Attendance (%)',
                            data: data,
                            backgroundColor: [
                                'rgba(71, 85, 105, 0.7)',   // slate-600
                                'rgba(100, 116, 139, 0.7)', // slate-500
                                'rgba(148, 163, 184, 0.7)', // slate-400
                                'rgba(203, 213, 225, 0.7)', // slate-300
                                'rgba(156, 163, 175, 0.7)', // gray-400
                                'rgba(209, 213, 219, 0.7)'  // gray-300
                            ],
                            borderColor: '#ffffff', // Clean white separators
                            borderWidth: 1.5,
                            hoverBackgroundColor: 'rgba(51, 65, 85, 0.9)' // slate-700 on hover
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            r: {
                                min: 0,
                                max: 100,
                                ticks: { stepSize: 20, backdropColor: 'transparent', display: false },
                                grid: { 
                                    // Fading grid lines from center (darker) to outer (lighter)
                                    color: [
                                        'rgba(0, 0, 0, 0.15)', // 20% mark
                                        'rgba(0, 0, 0, 0.08)', // 40% mark
                                        'rgba(0, 0, 0, 0.04)', // 60% mark
                                        'rgba(0, 0, 0, 0.01)', // 80% mark
                                        'rgba(0, 0, 0, 0)'     // 100% mark (completely transparent)
                                    ] 
                                },
                                angleLines: { display: false } // Hide straight angle lines for cleaner look
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    font: { family: "'Inter', sans-serif" },
                                    padding: 20
                                }
                            }
                        },
                        onClick: (event, elements, chart) => {
                            if (elements.length > 0) {
                                const index = elements[0].index;
                                const label = chart.data.labels[index];
                                const value = chart.data.datasets[0].data[index];
                                alert('Course Details:\n' + label + '\nAverage Attendance: ' + value + '%');
                            }
                        }
                    }
                });
            }
        });
    </script>
}
