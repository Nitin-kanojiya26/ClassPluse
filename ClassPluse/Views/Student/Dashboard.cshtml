@{
    ViewData["Title"] = "Student Dashboard";
    var dashboardData = ViewBag.DashboardData as IEnumerable<dynamic>;
    var recentActivity = ViewBag.RecentActivity as IEnumerable<ClassPluse.Models.AttendanceRecord>;
    bool hasLowAttendance = false;
}

<div class="row mb-5">
    <!-- Student Info Column -->
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Welcome, @ViewBag.UserFullName</h2>
                <p class="text-muted mb-0">@ViewBag.UserRollNumber</p>
            </div>
            <a asp-action="Scan" class="btn btn-primary btn-lg shadow-sm rounded-pill px-4">
                <i class="bi bi-qr-code-scan me-2"></i> Scan Attendance QR
            </a>
        </div>

        @if(dashboardData != null)
        {
            foreach(var data in dashboardData)
            {
                double percentage = data.Percentage;
                if (percentage < 75 && data.TotalSessions > 0)
                {
                    var course = data.Course as ClassPluse.Models.Course;
                    <div class="alert alert-warning shadow-sm border-0 rounded-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> 
                        ⚠️ Your attendance in <strong>@course?.CourseName</strong> is @percentage% — below the 75% requirement.
                    </div>
                    hasLowAttendance = true;
                }
            }
        }
    </div>
</div>

<div class="row">
    <!-- Left Column: Courses and Recent Activity -->
    <div class="col-lg-7">
        <h4 class="fw-bold mb-3 mt-2">Enrolled Courses</h4>
        <div class="row row-cols-1 row-cols-md-2 g-3 mb-5">
            @if(dashboardData != null && dashboardData.Any())
            {
                foreach(var data in dashboardData)
                {
                    var course = data.Course as ClassPluse.Models.Course;
                    var faculty = course?.Faculty;
                    double percentage = data.Percentage;
                    string colorClass = "success";
                    
                    if (percentage < 65)
                    {
                        colorClass = "danger";
                    }
                    else if (percentage < 75)
                    {
                        colorClass = "warning";
                    }

                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 transition-hover">
                            <div class="card-header bg-transparent border-0 pt-4 pb-0">
                                <h6 class="text-muted mb-1"><i class="bi bi-tag me-1"></i> @course?.CourseCode</h6>
                                <h5 class="card-title fw-bold mb-0 text-truncate" title="@course?.CourseName">@course?.CourseName</h5>
                            </div>
                            <div class="card-body">
                                <div class="text-center my-3">
                                    <h2 class="display-5 fw-bold text-@colorClass mb-0">@percentage%</h2>
                                </div>
                                <div class="progress rounded-pill mb-3" style="height: 10px; background-color: #f0f0f0;">
                                    <div class="progress-bar bg-@colorClass" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-check2-circle me-1"></i> @data.AttendedSessions / @data.TotalSessions lectures
                                </p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0 pb-4">
                                <a asp-action="History" asp-route-courseId="@course?.Id" class="btn btn-outline-secondary w-100 rounded-pill">
                                    <i class="bi bi-clock-history me-1"></i> View History
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 w-100">
                    <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-light">
                        <div class="card-body">
                            <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                            <h4 class="mt-3">No Courses Found</h4>
                            <p class="text-muted mb-0">You are not enrolled in any courses yet.</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (recentActivity != null && recentActivity.Any())
        {
            <h4 class="fw-bold mb-3">Recent Activity</h4>
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="ps-4 py-3">Date</th>
                                <th class="py-3">Course</th>
                                <th class="pe-4 py-3 text-end">Status</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach(var record in recentActivity)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="fw-medium">@record.MarkedAt.ToLocalTime().ToString("MMM dd")</span>
                                        <span class="text-muted small ms-2">@record.MarkedAt.ToLocalTime().ToString("hh:mm tt")</span>
                                    </td>
                                    <td class="py-3">
                                        @record.LectureSession?.Course?.CourseName
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        @if(record.Status == ClassPluse.Models.AttendanceStatus.Present)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2">Present</span>
                                        }
                                        else if(record.Status == ClassPluse.Models.AttendanceStatus.Absent)
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2">Absent</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@record.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Right Column: Overall Attendance -->
    <div class="col-lg-5">
        <h4 class="fw-bold mb-3 mt-2 mt-lg-0">Overall Attendance</h4>
        <div class="card shadow-sm border-0 rounded-4 bg-white sticky-top" style="top: 20px; z-index: 1;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <span class="text-muted fw-medium">Target: 75%</span>
                    <h3 class="fw-bold text-primary mb-0">@ViewBag.OverallAttendancePercentage%</h3>
                </div>
                
                <div class="progress rounded-pill mb-4 shadow-sm" style="height: 16px; background-color: #f0f0f0;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @ViewBag.OverallAttendancePercentage%" aria-valuenow="@ViewBag.OverallAttendancePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <hr class="my-4 text-muted opacity-25">

                <h5 class="fw-bold text-muted mb-3">Subjects Breakdown</h5>
                <div class="accordion accordion-flush" id="attendanceAccordion">
                    @{ int index = 0; }
                    @if(dashboardData != null && dashboardData.Any())
                    {
                        foreach(var data in dashboardData)
                        {
                            var course = data.Course as ClassPluse.Models.Course;
                            double percentage = data.Percentage;
                            string colorClass = percentage >= 75 ? "success" : (percentage >= 65 ? "warning" : "danger");
                            string collapseId = $"collapseCourse{index}";
                            string headingId = $"headingCourse{index}";

                            <div class="accordion-item border-0 mb-3 bg-transparent">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button collapsed rounded-3 border border-secondary border-opacity-25 bg-light py-3 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" style="box-shadow: none;">
                                        <div class="d-flex justify-content-between w-100 align-items-center me-2">
                                            <span class="fw-bold text-dark text-truncate" style="font-size: 0.95rem; max-width: 65%;">@course?.CourseName</span>
                                            <span class="badge bg-@colorClass rounded-pill px-2 py-1">@percentage%</span>
                                        </div>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#attendanceAccordion">
                                    <div class="accordion-body px-3 py-3 bg-white border border-top-0 rounded-bottom-3 border-secondary border-opacity-25 mt-n1">
                                        <div class="d-flex justify-content-between text-muted mb-2 small fw-medium">
                                            <span>Attended: @data.AttendedSessions / @data.TotalSessions</span>
                                            <span>@percentage%</span>
                                        </div>
                                        <div class="progress rounded-pill shadow-sm" style="height: 8px; background-color: #e9ecef;">
                                            <div class="progress-bar bg-@colorClass" role="progressbar" style="width: @percentage%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            index++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>


