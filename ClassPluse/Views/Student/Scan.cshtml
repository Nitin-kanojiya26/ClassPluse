@{
    ViewData["Title"] = "Scan QR Code";
    ViewData["HideNavbar"] = true; // hide the global navbar for a clean mobile experience
}

<div class="d-flex flex-column" style="min-height: 100vh;">
    <!-- Minimal Header -->
    <div class="d-flex justify-content-between align-items-center p-3 bg-white shadow-sm border-bottom">
        <a asp-action="Dashboard" class="btn btn-light rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <div class="d-flex align-items-center">
            <div class="bg-dark text-white rounded px-2 py-1 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-mortarboard-fill fs-6"></i>
            </div>
            <h5 class="fw-bold mb-0 text-dark" style="letter-spacing: -0.5px;">ClassPluse</h5>
        </div>
        <div style="width: 40px;"></div> <!-- Spacer for centering -->
    </div>

    <!-- Scanner Area -->
    <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center p-3" style="background-color: #f8f9fa;">
        <div class="w-100" style="max-width: 500px;">
            
            <!-- STEP 1: QR Scanner -->
            <div id="step1Container">
                <h4 class="text-center fw-bold mb-3">Step 1: Scan QR Code</h4>
                <div id="reader" class="rounded-4 overflow-hidden shadow bg-dark mb-4 border border-3 border-white" style="width: 100%;"></div>
            </div>

            <!-- STEP 2: Face Scanner -->
            <div id="step2Container" style="display: none;">
                <h4 class="text-center fw-bold mb-3">Step 2: Face Verification</h4>
                <div class="bg-dark rounded-4 overflow-hidden mb-4 position-relative mx-auto" style="width: 100%; max-width: 320px; aspect-ratio: 1; border: 4px solid #f8f9fa; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                    <video id="faceVideoElement" autoplay playsinline style="width: 100%; height: 100%; object-fit: cover;"></video>
                    <canvas id="faceCanvas" style="display: none;"></canvas>
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-center align-items-center" style="pointer-events: none;">
                        <div style="width: 60%; height: 60%; border: 2px dashed rgba(255,255,255,0.5); border-radius: 50%;"></div>
                    </div>
                </div>
                <button id="captureFaceBtn" class="btn btn-primary btn-lg rounded-pill w-100 fw-bold shadow-sm mb-3">
                    <i class="bi bi-camera me-2"></i> Verify Face & Mark Attendance
                </button>
            </div>
            
            <div id="statusContainer" class="text-center mt-2">
                <!-- Idle State -->
                <div id="stateIdle" class="text-muted">
                    <i class="bi bi-camera-video display-4 mb-2 d-block opacity-50"></i>
                    <p class="fs-5">Complete both steps to mark attendance.</p>
                </div>
                
                <!-- Success State -->
                <div id="stateSuccess" class="alert alert-success shadow-sm rounded-4 border-0 py-4" style="display: none;">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    <h4 class="alert-heading fw-bold mt-3">Success!</h4>
                    <p id="successMessage" class="mb-0 fs-5">Attendance marked successfully.</p>
                </div>
                
                <!-- Error State -->
                <div id="stateError" class="alert alert-danger shadow-sm rounded-4 border-0 py-4" style="display: none;">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
                    <h4 class="alert-heading fw-bold mt-3">Failed</h4>
                    <p id="errorMessage" class="mb-0 fs-5">QR code expired, ask your professor to refresh.</p>
                    <button class="btn btn-outline-danger mt-3 rounded-pill" onclick="resetScanner()">Start Over</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        let html5QrcodeScanner = null;
        let isProcessing = false;
        let capturedToken = "";
        let faceVideoStream = null;

        function setUIState(state, message = "") {
            document.getElementById('stateIdle').style.display = 'none';
            document.getElementById('stateSuccess').style.display = 'none';
            document.getElementById('stateError').style.display = 'none';

            if (state === 'idle') {
                document.getElementById('stateIdle').style.display = 'block';
            } else if (state === 'success') {
                document.getElementById('step1Container').style.display = 'none';
                document.getElementById('step2Container').style.display = 'none';
                document.getElementById('stateSuccess').style.display = 'block';
                document.getElementById('successMessage').textContent = message;
            } else if (state === 'error') {
                document.getElementById('step1Container').style.display = 'none';
                document.getElementById('step2Container').style.display = 'none';
                document.getElementById('stateError').style.display = 'block';
                document.getElementById('errorMessage').textContent = message;
            }
        }

        function resetScanner() {
            isProcessing = false;
            capturedToken = "";
            document.getElementById('step1Container').style.display = 'block';
            document.getElementById('step2Container').style.display = 'none';
            setUIState('idle');
            
            if (faceVideoStream) {
                faceVideoStream.getTracks().forEach(track => track.stop());
                faceVideoStream = null;
            }
            
            if (html5QrcodeScanner) {
                html5QrcodeScanner.render(onScanSuccess, onScanFailure);
            }
        }

        function extractToken(text) {
            try {
                if (text.includes('token=')) {
                    const url = new URL(text);
                    return url.searchParams.get('token') || text;
                }
            } catch (e) {}
            return text;
        }

        async function startFaceCamera() {
            try {
                faceVideoStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                const video = document.getElementById('faceVideoElement');
                video.srcObject = faceVideoStream;
            } catch (err) {
                console.error("Error accessing camera: ", err);
                setUIState('error', "Camera access is required for face verification.");
            }
        }

        function onScanSuccess(decodedText, decodedResult) {
            if (isProcessing) return;
            isProcessing = true;

            capturedToken = extractToken(decodedText);
            
            // Switch to Step 2 UI
            document.getElementById('step1Container').style.display = 'none';
            document.getElementById('step2Container').style.display = 'block';
            document.getElementById('stateIdle').style.display = 'none';
            
            if (html5QrcodeScanner) {
                html5QrcodeScanner.clear().then(() => {
                    // Turn on camera for face
                    startFaceCamera();
                }).catch(err => {
                    console.error("Failed to clear scanner", err);
                    startFaceCamera();
                });
            } else {
                startFaceCamera();
            }
        }

        document.getElementById('captureFaceBtn').addEventListener('click', () => {
            const btn = document.getElementById('captureFaceBtn');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Verifying...';
            btn.disabled = true;

            // Capture face frame
            const video = document.getElementById('faceVideoElement');
            const canvas = document.getElementById('faceCanvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const context = canvas.getContext('2d');
            context.drawImage(video, 0, 0, canvas.width, canvas.height);
            const faceImageBase64 = canvas.toDataURL('image/jpeg', 0.8);

            fetch('/api/AttendanceApi/mark', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token: capturedToken, faceImageBase64: faceImageBase64 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    setUIState('success', data.message);
                    if (faceVideoStream) {
                        faceVideoStream.getTracks().forEach(track => track.stop());
                    }
                    setTimeout(() => { window.location.href = '@Url.Action("Dashboard", "Student")'; }, 2000);
                } else {
                    setUIState('error', data.message || 'Verification failed');
                    btn.innerHTML = '<i class="bi bi-camera me-2"></i> Verify Face & Mark Attendance';
                    btn.disabled = false;
                }
            })
            .catch((error) => {
                console.error('Error:', error);
                setUIState('error', 'A network error occurred. Please try again.');
                btn.innerHTML = '<i class="bi bi-camera me-2"></i> Verify Face & Mark Attendance';
                btn.disabled = false;
            });
        });

        function onScanFailure(error) {
            // ignore continuous scanning errors
        }

        document.addEventListener("DOMContentLoaded", function() {
            const prefilledToken = '@Html.Raw(ViewBag.PrefilledToken ?? "")';
            
            if (prefilledToken) {
                // If a token was provided via query string (e.g., from a 3rd party QR scanner), skip directly to Step 2
                capturedToken = prefilledToken;
                document.getElementById('step1Container').style.display = 'none';
                document.getElementById('step2Container').style.display = 'block';
                document.getElementById('stateIdle').style.display = 'none';
                startFaceCamera();
            } else {
                // Otherwise, start the built-in HTML5 QR Scanner
                html5QrcodeScanner = new Html5QrcodeScanner(
                    "reader", { 
                        fps: 10, 
                        qrbox: { width: 250, height: 250 },
                        aspectRatio: 1.0,
                        showTorchButtonIfSupported: true
                    }, false);
                html5QrcodeScanner.render(onScanSuccess, onScanFailure);
            }
        });
    </script>
}
